                <Pin name="B" datatype="struct:transform"/>
                <Pin name="A x B" datatype="struct:transform" direction="out"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: ControlSize" name="Control Size" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Width" datatype="float" direction="out"/>
                <Pin name="Height" datatype="float" direction="out"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: FitTransform" name="Fit" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Width" datatype="float" default="100"/>
                <Pin name="Height" datatype="float" default="100"/>
                <Pin name="Design Width" datatype="float" default="100"/>
                <Pin name="Design Height" datatype="float" default="100"/>
                <Pin name="Transform" datatype="struct:transform" direction="out"/>
                <Pin name="Scale" datatype="float" direction="out"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: GradientStop" name="Gradient Stop" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Color" datatype="struct:color" default="FFFFFFFF"/>
                <Pin name="Position" datatype="float" default="-1"/>
                <Pin name="Stop" datatype="struct:gradientstop" direction="out"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: LinearGradient" name="Linear Gradient" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Angle" datatype="float" default="180"/>
                <Pin name="Brush" datatype="object:brush" direction="out"/>
                <Pin name="Stop" datatype="struct:gradientstop" autoRename="true" autoDuplicate="true"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: MouseTarget" name="MouseTarget" flags="384" category="Experimental/Cadmium">
            <GUI graphicsApi="GmpiGui">
                <Pin name="Hover" datatype="bool" direction="out"/>
                <Pin name="Left Click" datatype="bool" direction="out"/>
                <Pin name="Center Click" datatype="bool" direction="out"/>
                <Pin name="Right Click" datatype="bool" direction="out"/>
                <Pin name="Double Click" datatype="bool" direction="out"/>
                <Pin name="X" datatype="float" direction="out"/>
                <Pin name="Y" datatype="float" direction="out"/>
                <Pin name="dX" datatype="float" direction="out"/>
                <Pin name="dY" datatype="float" direction="out"/>
                <Pin name="Wheel" datatype="float" direction="out"/>
                <Pin name="Hint" datatype="string_utf8"/>
                <Pin name="Auto Size" datatype="bool" isMinimised="true"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: Multiline" name="Multiline" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Path" datatype="object:path" direction="out"/>
                <Pin name="Point" datatype="struct:point" autoDuplicate="true"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: Multiply" name="Multiply" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Value" datatype="float"/>
                <Pin name="Value" datatype="float"/>
                <Pin name="Value" datatype="float" direction="out"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: PatchMemGet" name="Value" flags="384" category="Experimental/Cadmium">
            <Parameters>
                <Parameter id="0" datatype="float" name=""/>
            </Parameters>
            <Audio>
                <Pin name="Value-in" datatype="float" private="true" parameterId="0"/>
                <Pin name="Value" datatype="float" direction="out"/>
            </Audio>
            <GUI>
                <Pin name="Normalized-in" datatype="float" private="true" parameterId="0" parameterField="Normalized"/>
                <Pin name="MouseDown-in" datatype="bool" private="true" parameterId="0" parameterField="Grab"/>
                <Pin name="Value-in" datatype="float" private="true" parameterId="0"/>
                <Pin name="ID" datatype="int" direction="out"/>
                <Pin name="Normalized" datatype="float" direction="out"/>
                <Pin name="MouseDown" datatype="bool" direction="out"/>
                <Pin name="Value" datatype="float" direction="out"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: PatchMemSet" name="Value Set" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="ID" datatype="int" default="-1"/>
                <Pin name="Normalized" datatype="float"/>
                <Pin name="MouseDown" datatype="bool"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: Point" name="Point" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="X" datatype="float"/>
                <Pin name="Y" datatype="float"/>
                <Pin name="Point" datatype="struct:point" direction="out"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: RadialGradient" name="Radial Gradient" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Radius X" datatype="float" default="50"/>
                <Pin name="Radius Y" datatype="float" default="50"/>
                <Pin name="Center X" datatype="float" default="50"/>
                <Pin name="Center Y" datatype="float" default="50"/>
                <Pin name="Brush" datatype="object:brush" direction="out"/>
                <Pin name="Stop" datatype="struct:gradientstop" autoRename="true" autoDuplicate="true"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: RenderGeometry" name="Render" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Path" datatype="object:path"/>
                <Pin name="Style" datatype="object:style"/>
                <Pin name="Panel Rect" datatype="struct:rect" private="true"/>
                <Pin name="Transform" datatype="struct:transform"/>
                <Pin name="Clip" datatype="object:path"/>
                <Pin name="Auto Size" datatype="bool" isMinimised="true"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: Rotation" name="Rotation" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Angle (turns)" datatype="float"/>
                <Pin name="Transform" datatype="struct:transform" direction="out"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: SolidBrush" name="Solid Brush" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Color" datatype="struct:color" default="FFFFFFFF"/>
                <Pin name="Brush" datatype="object:brush" direction="out"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: Style" name="Style" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Fill" datatype="object:brush"/>
                <Pin name="Stroke" datatype="object:brush"/>
                <Pin name="Stroke Width" datatype="float" default="1"/>
                <Pin name="Cap" datatype="enum" metadata="Flat,Square,Round"/>
                <Pin name="Glow Radius" datatype="float"/>
                <Pin name="Glow Color" datatype="struct:color"/>
                <Pin name="Style" datatype="object:style" direction="out"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: Translation" name="Translation" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="X" datatype="float"/>
                <Pin name="Y" datatype="float"/>
                <Pin name="Transform" datatype="struct:transform" direction="out"/>
            </GUI>
        </Plugin>
    </PluginList>
