        <Plugin id="SE: StyleBuilder" name="Style" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Fill" datatype="struct:color"/>
                <Pin name="Stroke" datatype="struct:color"/>
                <Pin name="Stroke Width" datatype="float" default="1"/>
                <Pin name="Cap" datatype="enum" metadata="Flat,Square,Round"/>
                <Pin name="Style" datatype="object:style" direction="out"/>
                <Pin name="Glow Radius" datatype="float"/>
                <Pin name="Glow Color" datatype="struct:color"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: TextRender" name="Text Render" flags="384" category="Experimental/Cadmium">
            <GUI graphicsApi="GmpiGui">
                <Pin name="Text" datatype="string_utf8"/>
                <Pin name="Style" datatype="object:style"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: TicksGeometry" name="Ticks Geometry" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="Count" datatype="int" default="11"/>
                <Pin name="Width" datatype="float" default="100"/>
                <Pin name="Offset" datatype="float"/>
                <Pin name="Length" datatype="float" default="4"/>
                <Pin name="Major Every" datatype="int" default="5"/>
                <Pin name="Major Length" datatype="float" default="8"/>
                <Pin name="Path" datatype="object:path" direction="out"/>
            </GUI>
        </Plugin>
        <Plugin id="SE: Translation" name="Translation" flags="384" category="Experimental/Cadmium">
            <GUI>
                <Pin name="X" datatype="float"/>
                <Pin name="Y" datatype="float"/>
                <Pin name="Transform" datatype="struct:transform" direction="out"/>
            </GUI>
        </Plugin>
    </PluginList>
